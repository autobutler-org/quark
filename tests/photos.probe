# Smoke test for the photos page (#1732), driven by the quark_widgets key
# prefixes. Needs a signed-in session on a Quark with at least one photo.
# Photo tiles are keyed photo_tile_<serial>:<path>, which depends on the
# library, so this enters selection through the app bar's #photos_select.

test "photos page shows the library and enters selection"
  @smoke
  open the app
  tap #brand_button
  wait until #drawer_photos appears
  tap #drawer_photos
  wait until #photo_columns_slider appears
  tap #photo_columns_more
  tap #photo_category_toggle
  see #photo_category_favorites
  tap #photo_category_quark
  wait until #photo_grid appears
  see #album_create
  tap #photos_select
  see #file_selection_cancel
  tap #file_selection_cancel
