// Build settings for the AutoFill Credential Provider extension (#3598). It runs no Flutter, but reads
// Generated.xcconfig for FLUTTER_BUILD_NAME and FLUTTER_BUILD_NUMBER, so its version always matches the
// app's, which App Store Connect requires of an embedded extension.
#include "../Flutter/Generated.xcconfig"

// scripts/ios-ci-signing.bash writes the extension's manual signing here on CI. Never committed.
#include? "Signing.ci.xcconfig"
