# Mac OS X files
.DS_Store

# Binaries for programs and plugins
./quark
# Distribution directory
internal/server/public/*
!internal/server/public/stub.txt
# Datalinks
datalinks/mac

tmp/

*.exe
*.exe~
*.dll
*.so
*.dylib
__debug*

# Test binary, build with `go test -c`
*.test

