migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
# Pub workspace: only the root lockfile is real; members resolve through it.
packages/**/pubspec.lock
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Setup artifacts
flutter.zip

# Flutter Linux artifacts
/linux/

# AI slop
## Playwright / test artifacts
playwright-report/
test-results/performance/*
!test-results/performance/.gitkeep

# Ralph loops
.ralph/
## `dart run skills@ get` writes install timestamps and hashes here. Per
## developer, and per agent they chose, so it is not shared state.
.config/dart_skills/

## Claude Code workspace (agents are shared; everything else is per-developer)
.claude/*
!.claude/agents/
!.claude/skills/
.claude/skills/dart-*
.claude/skills/flutter-*

## Sable's personal dev context (AI co-developer workspace)
sable/
## ExoKomodo's personal dev context (AI co-developer workspace)
exokomodo/
linux/flutter/ephemeral/

# SBOM generated at build time from pubspec.lock
assets/sbom_flutter.json
.beads/
.codex/
.agents/

# Test plugin binary (built by plugin subprocess host tests)
/testplugin

# Generated on CI runners by scripts/ios-ci-signing.bash
ios/ExportOptions.ci.plist

# Google service account keys. Play Console downloads them as
# <project>-<keyid>.json, which no existing rule matched -- one landed at the
# repo root during setup, unignored, next to a `git add -A`. The documented
# home is ~/.config/quark/play-service-account.json, outside the repo.
*service-account*.json
quark-[0-9]*-*.json
