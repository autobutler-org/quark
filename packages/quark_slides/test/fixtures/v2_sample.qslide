{
  "schemaVersion": 2,
  "title": "Sample deck",
  "size": {
    "width": 1920,
    "height": 1080
  },
  "theme": {
    "id": "sample",
    "name": "Sample",
    "colors": {
      "background": "#FFF8F0",
      "text": "#3B2A20",
      "background2": "#F6E7D8",
      "text2": "#7A5C48",
      "accent1": "#C2410C",
      "accent2": "#B45309",
      "accent3": "#A16207",
      "accent4": "#BE123C",
      "accent5": "#9D174D",
      "accent6": "#4D7C0F"
    },
    "headingFont": "Georgia",
    "bodyFont": "Inter",
    "title": {
      "fontSize": 60,
      "color": "theme:text",
      "heading": true
    },
    "subtitle": {
      "fontSize": 40,
      "color": "theme:text2"
    },
    "body": {
      "fontSize": 36,
      "color": "theme:text"
    },
    "shapes": {
      "fill": "theme:accent1",
      "stroke": {
        "color": "theme:accent2",
        "width": 2
      },
      "line": {
        "color": "theme:text",
        "width": 4
      }
    }
  },
  "slides": [
    {
      "id": "s1",
      "background": {
        "color": "#102030"
      },
      "elements": [
        {
          "id": "e1",
          "type": "text",
          "frame": {
            "x": 160,
            "y": 120,
            "width": 1600,
            "height": 240
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "Hello, ",
                  "fontSize": 72
                },
                {
                  "text": "slides",
                  "bold": true,
                  "italic": true,
                  "underline": true,
                  "strikethrough": true,
                  "fontSize": 72,
                  "fontFamily": "Inter",
                  "color": "#FFCC00"
                }
              ],
              "align": "center"
            },
            {
              "runs": []
            },
            {
              "runs": [
                {
                  "text": "Second line"
                }
              ],
              "lineSpacing": 1.5,
              "list": "numbered"
            }
          ],
          "anchor": "middle",
          "autoFit": "shrink",
          "placeholder": "Click to add title"
        },
        {
          "id": "e2",
          "type": "shape",
          "frame": {
            "x": 100.5,
            "y": 600,
            "width": 400,
            "height": 300,
            "rotation": 15
          },
          "kind": "ellipse",
          "fill": "#3366FF80",
          "stroke": {
            "color": "#FFFFFF",
            "width": 4,
            "dash": "dashDot"
          },
          "opacity": 0.75
        },
        {
          "id": "e6",
          "type": "shape",
          "frame": {
            "x": 1500,
            "y": 700,
            "width": 300,
            "height": 200
          },
          "kind": "roundedRectangle",
          "fill": "#FFFFFF",
          "cornerRadius": 24
        },
        {
          "id": "e7",
          "type": "image",
          "frame": {
            "x": 1500,
            "y": 100,
            "width": 200,
            "height": 100
          },
          "source": "asset:logo-1"
        },
        {
          "id": "e8",
          "type": "group",
          "frame": {
            "x": 100,
            "y": 100,
            "width": 600,
            "height": 400,
            "rotation": 30
          },
          "children": [
            {
              "id": "e9",
              "type": "text",
              "frame": {
                "x": 0,
                "y": 0,
                "width": 600,
                "height": 100
              },
              "paragraphs": [
                {
                  "runs": [
                    {
                      "text": "Grouped"
                    }
                  ]
                }
              ]
            },
            {
              "id": "e10",
              "type": "group",
              "frame": {
                "x": 0,
                "y": 200,
                "width": 400,
                "height": 200
              },
              "children": [
                {
                  "id": "e11",
                  "type": "shape",
                  "frame": {
                    "x": 0,
                    "y": 0,
                    "width": 200,
                    "height": 200
                  },
                  "kind": "star"
                },
                {
                  "id": "e12",
                  "type": "image",
                  "frame": {
                    "x": 200,
                    "y": 0,
                    "width": 200,
                    "height": 200
                  },
                  "source": "photos/cat.jpg"
                }
              ]
            }
          ]
        }
      ],
      "notes": "Welcome everyone."
    },
    {
      "id": "s2",
      "background": {
        "image": "photos/sky.jpg"
      },
      "elements": [
        {
          "id": "e3",
          "type": "image",
          "frame": {
            "x": 0,
            "y": 0,
            "width": 960,
            "height": 1080
          },
          "source": "photos/dog.jpg",
          "altText": "A dog on a beach",
          "fit": "cover"
        },
        {
          "id": "e4",
          "type": "line",
          "frame": {
            "x": 1000,
            "y": 200,
            "width": 600,
            "height": 0
          },
          "stroke": {
            "color": "#FF0000",
            "width": 3
          },
          "flipped": true,
          "endCap": "arrow",
          "opacity": 0.5
        },
        {
          "id": "e5",
          "type": "shape",
          "frame": {
            "x": 1200,
            "y": 700,
            "width": 200,
            "height": 200
          },
          "kind": "rectangle"
        }
      ]
    },
    {
      "id": "s3",
      "elements": []
    },
    {
      "id": "s4",
      "elements": [
        {
          "id": "e13",
          "type": "text",
          "frame": {
            "x": 115.2,
            "y": 54,
            "width": 1689.6,
            "height": 162
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "Agenda",
                  "color": "theme:accent2"
                }
              ]
            }
          ],
          "anchor": "middle",
          "autoFit": "shrink",
          "placeholder": "Click to add title",
          "slot": "title",
          "textRole": "title"
        },
        {
          "id": "e14",
          "type": "text",
          "frame": {
            "x": 115.2,
            "y": 259.2,
            "width": 1689.6,
            "height": 734.4
          },
          "paragraphs": [
            {
              "runs": []
            }
          ],
          "autoFit": "shrink",
          "placeholder": "Click to add text",
          "slot": "body"
        },
        {
          "id": "e15",
          "type": "shape",
          "frame": {
            "x": 1500,
            "y": 800,
            "width": 200,
            "height": 200
          },
          "kind": "rectangle",
          "fill": "theme:accent1",
          "stroke": {
            "color": "theme:text",
            "width": 2
          }
        }
      ],
      "layout": "titleAndContent"
    }
  ]
}
