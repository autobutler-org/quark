{
  "schemaVersion": 1,
  "title": "Sample deck",
  "size": {
    "width": 1920,
    "height": 1080
  },
  "theme": "themes/default",
  "slides": [
    {
      "id": "s1",
      "background": {
        "color": "#102030"
      },
      "elements": [
        {
          "id": "e1",
          "type": "text",
          "frame": {
            "x": 160,
            "y": 120,
            "width": 1600,
            "height": 240
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "Hello, ",
                  "fontSize": 72
                },
                {
                  "text": "slides",
                  "bold": true,
                  "italic": true,
                  "underline": true,
                  "strikethrough": true,
                  "fontSize": 72,
                  "fontFamily": "Inter",
                  "color": "#FFCC00"
                }
              ],
              "align": "center"
            },
            {
              "runs": []
            },
            {
              "runs": [
                {
                  "text": "Second line"
                }
              ],
              "lineSpacing": 1.5,
              "list": "numbered"
            }
          ],
          "anchor": "middle",
          "autoFit": "shrink",
          "placeholder": "Click to add title"
        },
        {
          "id": "e2",
          "type": "shape",
          "frame": {
            "x": 100.5,
            "y": 600,
            "width": 400,
            "height": 300,
            "rotation": 15
          },
          "kind": "ellipse",
          "fill": "#3366FF80",
          "stroke": {
            "color": "#FFFFFF",
            "width": 4,
            "dash": "dashDot"
          },
          "opacity": 0.75
        },
        {
          "id": "e6",
          "type": "shape",
          "frame": {
            "x": 1500,
            "y": 700,
            "width": 300,
            "height": 200
          },
          "kind": "roundedRectangle",
          "fill": "#FFFFFF",
          "cornerRadius": 24
        },
        {
          "id": "e7",
          "type": "image",
          "frame": {
            "x": 1500,
            "y": 100,
            "width": 200,
            "height": 100
          },
          "source": "asset:logo-1"
        },
        {
          "id": "e8",
          "type": "group",
          "frame": {
            "x": 100,
            "y": 100,
            "width": 600,
            "height": 400,
            "rotation": 30
          },
          "children": [
            {
              "id": "e9",
              "type": "text",
              "frame": {
                "x": 0,
                "y": 0,
                "width": 600,
                "height": 100
              },
              "paragraphs": [
                {
                  "runs": [
                    {
                      "text": "Grouped"
                    }
                  ]
                }
              ]
            },
            {
              "id": "e10",
              "type": "group",
              "frame": {
                "x": 0,
                "y": 200,
                "width": 400,
                "height": 200
              },
              "children": [
                {
                  "id": "e11",
                  "type": "shape",
                  "frame": {
                    "x": 0,
                    "y": 0,
                    "width": 200,
                    "height": 200
                  },
                  "kind": "star"
                },
                {
                  "id": "e12",
                  "type": "image",
                  "frame": {
                    "x": 200,
                    "y": 0,
                    "width": 200,
                    "height": 200
                  },
                  "source": "photos/cat.jpg"
                }
              ]
            }
          ]
        }
      ],
      "notes": "Welcome everyone."
    },
    {
      "id": "s2",
      "background": {
        "image": "photos/sky.jpg"
      },
      "elements": [
        {
          "id": "e3",
          "type": "image",
          "frame": {
            "x": 0,
            "y": 0,
            "width": 960,
            "height": 1080
          },
          "source": "photos/dog.jpg",
          "altText": "A dog on a beach",
          "fit": "cover"
        },
        {
          "id": "e4",
          "type": "line",
          "frame": {
            "x": 1000,
            "y": 200,
            "width": 600,
            "height": 0
          },
          "stroke": {
            "color": "#FF0000",
            "width": 3
          },
          "flipped": true,
          "endCap": "arrow",
          "opacity": 0.5
        },
        {
          "id": "e5",
          "type": "shape",
          "frame": {
            "x": 1200,
            "y": 700,
            "width": 200,
            "height": 200
          },
          "kind": "rectangle"
        }
      ]
    },
    {
      "id": "s3",
      "elements": []
    }
  ]
}
