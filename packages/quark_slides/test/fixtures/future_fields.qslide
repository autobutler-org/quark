{
  "schemaVersion": 1,
  "title": "Written by a newer Quark",
  "size": {"width": 1024, "height": 768, "unit": "pt"},
  "slides": [
    {
      "id": "s1",
      "layout": "title-and-body",
      "background": {"color": "#FFFFFF", "gradient": {"to": "#000000"}},
      "elements": [
        {
          "id": "e1",
          "type": "text",
          "frame": {"x": 10, "y": 20, "width": 300, "height": 50, "locked": true},
          "shrinkToFit": "shrink",
          "paragraphs": [
            {
              "runs": [{"text": "Hi", "highlight": "#FFFF00"}],
              "spacingAfter": 12
            }
          ]
        },
        {
          "id": "e2",
          "type": "shape",
          "kind": "rectangle",
          "frame": {"x": 0, "y": 0, "width": 10, "height": 10},
          "stroke": {"color": "#000000", "width": 1, "dash": [4, 2]},
          "shadow": {"blur": 8}
        },
        {
          "id": "e3",
          "type": "chart",
          "frame": {"x": 400, "y": 300, "width": 500, "height": 300},
          "series": [{"name": "Revenue", "values": [1, 2, 3]}]
        },
        {
          "id": "e4",
          "type": "shape",
          "kind": "heart",
          "frame": {"x": 5, "y": 5, "width": 50, "height": 50},
          "fill": "#FF0000"
        }
      ],
      "transition": {"kind": "fade", "duration": 0.3}
    }
  ],
  "comments": [{"author": "ada", "text": "Nice"}]
}
