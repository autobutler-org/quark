{
  "schemaVersion": 3,
  "title": "Written by a newer Quark",
  "size": {"width": 1024, "height": 768, "unit": "pt"},
  "theme": {
    "id": "ours",
    "name": "Ours",
    "colors": {
      "background": "#FFFFFF",
      "text": "#000000",
      "background2": "#EEEEEE",
      "text2": "#444444",
      "accent1": "#3366FF",
      "accent2": "#00A3A3",
      "accent3": "#F59E0B",
      "accent4": "#E5484D",
      "accent5": "#8B5CF6",
      "accent6": "#22C55E",
      "accent7": "#123456"
    },
    "title": {"fontSize": 60, "color": "theme:text", "heading": true, "letterSpacing": 2},
    "subtitle": {"fontSize": 40, "color": "theme:text2"},
    "body": {"fontSize": 36, "color": "theme:text"},
    "shapes": {"fill": "theme:accent1", "line": {"color": "theme:text", "width": 4}, "shadow": true},
    "gradients": [{"from": "accent1", "to": "accent2"}]
  },
  "slides": [
    {
      "id": "s1",
      "layout": "title-and-body",
      "background": {"color": "#FFFFFF", "gradient": {"to": "#000000"}},
      "elements": [
        {
          "id": "e1",
          "type": "text",
          "frame": {"x": 10, "y": 20, "width": 300, "height": 50, "locked": true},
          "shrinkToFit": "shrink",
          "paragraphs": [
            {
              "runs": [{"text": "Hi", "highlight": "#FFFF00"}],
              "spacingAfter": 12
            }
          ]
        },
        {
          "id": "e2",
          "type": "shape",
          "kind": "rectangle",
          "frame": {"x": 0, "y": 0, "width": 10, "height": 10},
          "stroke": {"color": "#000000", "width": 1, "dash": [4, 2]},
          "shadow": {"blur": 8}
        },
        {
          "id": "e3",
          "type": "chart",
          "frame": {"x": 400, "y": 300, "width": 500, "height": 300},
          "series": [{"name": "Revenue", "values": [1, 2, 3]}]
        },
        {
          "id": "e4",
          "type": "shape",
          "kind": "heart",
          "frame": {"x": 5, "y": 5, "width": 50, "height": 50},
          "fill": "#FF0000"
        },
        {
          "id": "e5",
          "type": "group",
          "frame": {"x": 600, "y": 0, "width": 300, "height": 200},
          "locked": true,
          "children": [
            {
              "id": "e6",
              "type": "chart",
              "frame": {"x": 0, "y": 0, "width": 300, "height": 100},
              "series": [{"name": "Cost", "values": [3, 2]}]
            },
            {
              "id": "e7",
              "type": "shape",
              "kind": "rectangle",
              "frame": {"x": 0, "y": 100, "width": 300, "height": 100},
              "glow": 4
            }
          ]
        }
      ],
      "animations": [{"element": "e1", "effect": "flyIn", "durationMs": 300}]
    }
  ],
  "comments": [{"author": "ada", "text": "Nice"}]
}
